<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.kylecorry.trail_sense.shared.views.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rightButtonIcon="@drawable/ic_check"
            app:showSubtitle="true"
            app:subtitle="@string/bottom_nav_customization"
            app:title="@string/bottom_navigation_bar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Live Preview Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/bottom_nav_preview"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <!-- Live Preview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/preview_bar_container"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <!-- Preview Slot 1 -->
                        <LinearLayout
                            android:id="@+id/preview_slot_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <ImageView
                                android:id="@+id/preview_icon_1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Slot 1 icon"
                                app:tint="?attr/colorPrimary"
                                tools:src="@drawable/ic_location" />

                            <TextView
                                android:id="@+id/preview_name_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="10sp"
                                tools:text="Navigation" />
                        </LinearLayout>

                        <!-- Preview Slot 2 -->
                        <LinearLayout
                            android:id="@+id/preview_slot_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <ImageView
                                android:id="@+id/preview_icon_2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Slot 2 icon"
                                app:tint="?android:attr/textColorSecondary"
                                tools:src="@drawable/maps" />

                            <TextView
                                android:id="@+id/preview_name_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="10sp"
                                tools:text="Map" />
                        </LinearLayout>

                        <!-- Preview Slot 3 -->
                        <LinearLayout
                            android:id="@+id/preview_slot_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <ImageView
                                android:id="@+id/preview_icon_3"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Slot 3 icon"
                                app:tint="?android:attr/textColorSecondary"
                                tools:src="@drawable/ic_weather" />

                            <TextView
                                android:id="@+id/preview_name_3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="10sp"
                                tools:text="Weather" />
                        </LinearLayout>

                        <!-- Preview Slot 4 -->
                        <LinearLayout
                            android:id="@+id/preview_slot_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <ImageView
                                android:id="@+id/preview_icon_4"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Slot 4 icon"
                                app:tint="?android:attr/textColorSecondary"
                                tools:src="@drawable/ic_astronomy" />

                            <TextView
                                android:id="@+id/preview_name_4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="10sp"
                                tools:text="Astronomy" />
                        </LinearLayout>

                        <!-- Preview Slot 5 (Tools - Fixed) -->
                        <LinearLayout
                            android:id="@+id/preview_slot_5"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/preview_icon_5"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="Tools icon"
                                    android:src="@drawable/apps"
                                    app:tint="?android:attr/textColorSecondary" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_gravity="top|end"
                                    android:contentDescription="Locked"
                                    android:src="@drawable/ic_lock"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/preview_name_5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/tools"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Information banner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="@string/bottom_nav_info"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Header for customizable slots -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/bottom_nav_slots_header"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" />

                <!-- Customizable slots list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/custom_slots_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/list_item_bottom_nav_slot" />

                <!-- Header for fixed slot -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/bottom_nav_fixed_header"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" />

                <!-- Fixed Slot 5: Tools Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_fixed_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:alpha="0.85"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/fixed_lock_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Locked"
                            android:src="@drawable/ic_lock"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/fixed_slot_badge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="5."
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/fixed_lock_icon"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/fixed_tool_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Tools icon"
                            android:src="@drawable/apps"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/fixed_slot_badge"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/fixed_badge_container"
                            app:layout_constraintStart_toEndOf="@id/fixed_tool_icon"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/tools"
                                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/bottom_nav_tools_fixed_description"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/fixed_badge_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="?attr/colorSurfaceVariant"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:text="@string/bottom_nav_item_locked"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Reset to Defaults Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_defaults"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/bottom_nav_reset_to_default"
                    app:icon="@drawable/ic_baseline_refresh_24"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
