<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.kylecorry.trail_sense.shared.views.Toolbar
        android:id="@+id/emergency_call_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:showSubtitle="true"
        app:subtitle="@string/tool_emergency_call_summary"
        app:title="@string/tool_emergency_call_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/emergency_number_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="15sp"
                        tools:text="Varsayılan Acil Numara: 112" />

                    <TextView
                        android:id="@+id/emergency_contacts_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:textSize="14sp"
                        tools:text="Kayıtlı Kişiler: 0 kişi" />

                    <TextView
                        android:id="@+id/emergency_location_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:textSize="13sp"
                        tools:text="Konum: GPS alınıyor..." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hold-to-call Container -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <!-- Hold Progress Ring -->
                <ProgressBar
                    android:id="@+id/call_hold_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_emergency_call_circle"
                    android:visibility="gone" />

                <!-- Call Button -->
                <LinearLayout
                    android:id="@+id/btn_emergency_call"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_emergency_call_circle"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/tool_emergency_call_title"
                        android:src="@drawable/ic_emergency_call"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/btn_call_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/emergency_call_112_button"
                        android:textColor="@color/white"
                        android:textSize="22sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/call_instruction_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/emergency_hold_to_call"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <!-- Send SMS Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_emergency_sms"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/emergency_send_sms_button"
                android:textSize="15sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_send" />

            <!-- Emergency Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_emergency_settings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:text="@string/emergency_settings_button"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_settings" />

            <!-- Carrier & Offline Info Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/emergency_kvkk_carrier_notice"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
